# =============================================================
# SEGREDOS DO SERVIDOR (Supabase Edge Functions). Nunca use prefixo VITE_.
# Local:     npx supabase functions serve --env-file supabase/functions/.env
# Produção:  npx supabase secrets set --env-file supabase/functions/.env
#            (ou um a um: npx supabase secrets set AI_API_KEY=...)
# Copie para supabase/functions/.env e preencha.
# =============================================================

# Provedor de IA: gemini | openai | openai_compatible | none
# "none" desliga a IA no servidor e força o fallback estatístico/regras (RNF06).
AI_PROVIDER=gemini

# Chave da API de IA.
# Gemini: aistudio.google.com > Get API key (gratuita, sem cartão)
# OpenAI: platform.openai.com > API keys
AI_API_KEY=

# Modelo. Gemini: gemini-2.5-flash | OpenAI: gpt-4o-mini (ou outro do provedor)
AI_MODEL=gemini-2.5-flash

# Endpoint compatível com OpenAI (/chat/completions). Vazio = padrão do provedor:
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai/
#   openai -> https://api.openai.com/v1/
# Para Groq, OpenRouter, Ollama etc. use AI_PROVIDER=openai_compatible e informe a URL aqui.
AI_BASE_URL=

# E-mail de alertas (opcional — o painel de alertas funciona sem isto).
# Onde obter: resend.com > API Keys
RESEND_API_KEY=

# Remetente. Sem domínio verificado use onboarding@resend.dev (só envia para o e-mail da sua conta Resend).
ALERT_EMAIL_FROM=SENN AI-X <onboarding@resend.dev>

# Destinatários dos alertas, separados por vírgula.
ALERT_EMAIL_TO=

# service_role: JÁ É INJETADA automaticamente nas Edge Functions (a CLI ignora nomes SUPABASE_*).
# Só é lida pelos scripts locais (scripts/seed-users.mjs, scripts/backup.mjs). Ignora RLS: nunca expor.
# Onde obter: Project Settings > API Keys > service_role / secret
SUPABASE_SERVICE_ROLE_KEY=

# Origem permitida no CORS das funções (ex.: https://seu-app.vercel.app). Vazio = qualquer origem
# (seguro porque a autenticação é por token Bearer, não cookie).
ALLOWED_ORIGIN=
