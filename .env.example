# =============================================================
# Variáveis PÚBLICAS do front-end (Vite). Tudo com prefixo VITE_
# vai parar no bundle do navegador: NUNCA coloque segredos aqui.
# Chaves de IA, Resend e service_role ficam em supabase/functions/.env
# Copie este arquivo para .env e preencha. Valor vazio = padrão indicado.
# =============================================================

# URL do projeto Supabase.
# Onde obter: supabase.com/dashboard > seu projeto > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública anon (ou "publishable key", sb_publishable_...). É segura no front porque o RLS protege os dados.
# Onde obter: Project Settings > API Keys > anon / publishable
VITE_SUPABASE_ANON_KEY=

# Liga/desliga as chamadas de IA (Edge Function "ai"). false = usa só os algoritmos locais (RNF06).
VITE_ENABLE_AI=true

# Liga/desliga o mapa. false = telas mostram tabelas com lat/lng no lugar do mapa (RNF06).
VITE_ENABLE_MAPS=true

# Servidor de tiles do mapa (OpenStreetMap, sem chave). Pode trocar por outro servidor compatível.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Geocodificação de endereços (Nominatim/OSM, sem chave; limite de 1 requisição por segundo).
# Se falhar, o formulário aceita latitude/longitude digitadas.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Intervalo do polling de fallback (ms) quando o Supabase Realtime cair.
VITE_POLLING_MS=15000
